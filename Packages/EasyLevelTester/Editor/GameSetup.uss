.custom-toggle {
    color: rgb(238, 238, 238);
    padding-bottom: 4px;
    padding-top: 4px;
    text-shadow: 2px 2px 0 rgb(0, 0, 0);
    background-size: contain;
    background-position: center;
    transition-duration: 0.1s;
}

.custom-toggle > .unity-toggle__input > .unity-toggle__checkmark {
    scale: 0.8 0.8;
    background-image: url("project://database/Packages/com.coppercoatstudios.easyleveltester/Editor/Textures/ToggleUnchecked.png");
}

.custom-toggle > .unity-toggle__input:checked > .unity-toggle__checkmark {
    background-image: url("project://database/Packages/com.coppercoatstudios.easyleveltester/Editor/Textures/ToggleChecked.png");
}

.custom-toggle > .unity-toggle__input:hover > .unity-toggle__checkmark {
    scale: 1 1;
}

.custom-toggle > .unity-toggle__input:active > .unity-toggle__checkmark {
    scale: 0.75 0.75;
}

.Content-Section {
    flex-grow: 1;
    margin-bottom: 4px;
    border-bottom-width: 2px;
    border-left-color: rgb(34, 40, 49);
    border-right-color: rgb(34, 40, 49);
    border-top-color: rgb(34, 40, 49);
    border-bottom-color: rgb(34, 40, 49);
    margin-top: 4px;
    flex-wrap: nowrap;
    padding-bottom: 5px;
    padding-left: 5px;
    padding-right: 5px;
}

.unity-foldout {
    color: rgb(238, 238, 238);
}

.unity-foldout__content {
    color: rgb(238, 238, 238);
}

.unity-tree-view {
    --unity-colors-alternated_rows-background: rgb(238, 238, 238);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-left-color: rgb(214, 90, 49);
    border-right-color: rgb(214, 90, 49);
    border-top-color: rgb(214, 90, 49);
    border-bottom-color: rgb(214, 90, 49);
    background-color: rgb(34, 40, 49);
}

.unity-collection-view__item--alternative-background {
    background-color: rgb(57, 62, 70);
}

.unity-base-text-field:hover {
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-left-color: rgb(214, 90, 49);
    border-right-color: rgb(214, 90, 49);
    border-top-color: rgb(214, 90, 49);
    border-bottom-color: rgb(214, 90, 49);
}

.unity-object-field__input:hover {
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-left-color: rgb(214, 90, 49);
    border-right-color: rgb(214, 90, 49);
    border-top-color: rgb(214, 90, 49);
    border-bottom-color: rgb(214, 90, 49);
}

.ELT-Header {
    flex-wrap: wrap;
    color: rgb(214, 90, 49);
    text-shadow: 2px 2px 0 rgb(0, 0, 0);
    -unity-font-style: bold;
    white-space: normal;
    font-size: 20px;
    margin-top: 4px;
    margin-bottom: 4px;
    -unity-text-align: middle-left;
}

.ELT-Subheader {
    flex-wrap: wrap;
    color: rgb(214, 90, 49);
    text-shadow: 2px 2px 0 rgb(0, 0, 0);
    -unity-font-style: normal;
    white-space: normal;
    font-size: 16px;
    margin-bottom: 4px;
    -unity-text-align: middle-left;
}

.ELT-Text {
    flex-wrap: wrap;
    color: rgb(238, 238, 238);
    text-shadow: 2px 2px 0 rgb(0, 0, 0);
    -unity-font-style: normal;
    white-space: normal;
    font-size: 12px;
    margin-bottom: 4px;
    -unity-text-align: middle-left;
}
