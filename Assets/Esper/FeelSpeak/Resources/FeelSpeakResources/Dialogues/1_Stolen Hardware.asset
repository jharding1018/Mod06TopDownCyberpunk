    emotion: {fileID: 0}
    suppressEmotionAnimation: 0
    suppressEmotionSound: 0
    automaticNextOnComplete: 0
    automaticNextDelay: 0
    dialogue: "I\u2019ve already wiped the internal records, but if copies of that
      tech start popping up they\u2019ll trace it back to me eventually."
    voiceLine: {fileID: 0}
  - graphId: 1
    id: 3
    position: {x: 1067, y: 225}
