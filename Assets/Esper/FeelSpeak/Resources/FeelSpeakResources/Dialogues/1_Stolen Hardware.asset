    inputConnections: []
    outputConnections: []
    character: {fileID: 11400000, guid: b50240ffaedcf8f4ab57b934260ac99b, type: 2}
    emotion: {fileID: 0}
    suppressEmotionAnimation: 0
    suppressEmotionSound: 0
    automaticNextOnComplete: 0
    automaticNextDelay: 0
    dialogue: " I lost a piece of combat hardware that belongs to Shirogane Arms
      and if they find out it\u2019s over for me."
    voiceLine: {fileID: 0}
  - graphId: 1
    id: 2
    position: {x: 902, y: 201}
