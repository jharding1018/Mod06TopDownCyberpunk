    emotion: {fileID: 0}
    suppressEmotionAnimation: 0
    suppressEmotionSound: 0
    automaticNextOnComplete: 0
    automaticNextDelay: 0
    dialogue: " I need you to recover the weapon. What you do with it afterwards
      I don\u2019t care, consider it the payment for the job."
    voiceLine: {fileID: 0}
